{
  "name": "clipped",
  "version": "0.9.3",
  "private": true,
  "description": "A feature board Claude keeps for you while you build.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "board": "bin/board",
    "clipped": "bin/clipped"
  },
  "scripts": {
    "build": "npm run bundle",
    "bundle": "esbuild cli/src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=bin/board.cjs --define:import.meta.url=__filename --log-level=warning && chmod +x bin/board bin/board.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "board": "node bin/board",
    "plugin:sync": "claude plugin uninstall clipped@clipped >/dev/null 2>&1; claude plugin install clipped@clipped"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
